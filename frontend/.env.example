# PlantPulse AI Frontend Environment Configuration
# If left blank, the frontend uses relative paths (/api/v1) which are proxied locally by Vite or by Vercel rewrites.
# For production deployment where backend is hosted separately (e.g. Render, Railway, Fly.io),
# set this to your backend's public HTTPS URL (e.g., https://plantpulse-backend.onrender.com)
VITE_API_BASE_URL=""
